# Port 5001 on purpose: macOS reserves 5000 for AirPlay Receiver.
# If you change it, change the proxy target in client/vite.config.ts too.
PORT=5001

# --- pick ONE MONGO_URI ---------------------------------------------------
# A) Local MongoDB (run `docker compose up -d` in the project root)
MONGO_URI=mongodb://127.0.0.1:27017/ascii_cam

# B) MongoDB Atlas (free M0 cluster) — copy the string from Atlas -> Connect -> Drivers,
#    put your database user's password in, and add the database name before the "?":
# MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/ascii_cam?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d
CLIENT_ORIGIN=http://localhost:5173

# --- Social sign-in (optional; a button only appears when both values are set) ---
# Public URL of this API, used to build the OAuth callback addresses
SERVER_URL=http://localhost:5001
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
#   Authorized redirect URI: http://localhost:5001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers -> New OAuth App
#   Authorization callback URL: http://localhost:5001/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
